<Window x:Class="TrackIRLite.CameraIndexDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Camera" Width="260" Height="140"
        Style="{StaticResource DialogWindow}"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <StackPanel>
        <TextBlock x:Name="TitleText" Style="{StaticResource DialogTitle}" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,5">
            <TextBlock Text="Index:" FontWeight="Bold" VerticalAlignment="Center" Margin="5,0" />
            <TextBox x:Name="IndexBox" Text="0" Width="40" FontWeight="Bold" Margin="5,0"
                     HorizontalContentAlignment="Center" Style="{StaticResource FlatTextBox}" />
        </StackPanel>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10">
            <Button Content="CONNECT" Width="80" Padding="0,4" Margin="5,0" FontWeight="Bold"
                    Style="{StaticResource FlatButton}" Click="Connect_Click" />
            <Button Content="CANCEL" Width="80" Padding="0,4" Margin="5,0"
                    Style="{StaticResource QuitButton}" Click="Cancel_Click" />
        </StackPanel>
    </StackPanel>
</Window>
