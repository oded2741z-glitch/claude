<Window x:Class="TrackIRLite.ConfigDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Configuration" Width="300" SizeToContent="Height"
        Style="{StaticResource DialogWindow}" WindowStartupLocation="CenterOwner"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">
    <StackPanel Margin="0,0,0,15">
        <TextBlock Text="CONFIGURATION" Style="{StaticResource DialogTitle}" />

        <TextBlock Text="Input Lens Type:" HorizontalAlignment="Center" Margin="0,2" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnStandard" Content="Standard" Width="80" Padding="0,4" Margin="3,0" Style="{StaticResource FlatButton}" Click="Lens_Click" />
            <Button x:Name="BtnFisheye" Content="Fisheye" Width="80" Padding="0,4" Margin="3,0" Style="{StaticResource FlatButton}" Click="Lens_Click" />
        </StackPanel>

        <TextBlock Text="Base FOV (Zoom):" HorizontalAlignment="Center" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Slider x:Name="FovSlider" Width="160" Minimum="30" Maximum="120" TickFrequency="1" Style="{StaticResource FlatSlider}" />
            <TextBlock Text="{Binding Value, ElementName=FovSlider}" Width="30" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="Target FPS:" HorizontalAlignment="Center" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Slider x:Name="FpsSlider" Width="160" Minimum="15" Maximum="60" TickFrequency="1" Style="{StaticResource FlatSlider}" />
            <TextBlock Text="{Binding Value, ElementName=FpsSlider}" Width="30" Margin="8,0,0,0" VerticalAlignment="Center" />
        </StackPanel>

        <TextBlock Text="Video Decoding:" HorizontalAlignment="Center" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnCpu" Content="CPU" Width="80" Padding="0,4" Margin="3,0" Style="{StaticResource FlatButton}" Click="Decoding_Click" />
            <Button x:Name="BtnGpu" Content="GPU" Width="80" Padding="0,4" Margin="3,0" Style="{StaticResource FlatButton}" Click="Decoding_Click" />
        </StackPanel>

        <TextBlock Text="Input Device:" HorizontalAlignment="Center" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
            <Button x:Name="BtnMouse" Content="MOUSE" Width="80" Padding="0,4" Margin="3,0" Style="{StaticResource FlatButton}" Click="Input_Click" />
            <Button x:Name="BtnTrackIR" Content="TRACKIR" Width="80" Padding="0,4" Margin="3,0" Style="{StaticResource FlatButton}" Click="Input_Click" />
        </StackPanel>

        <TextBlock Text="Mouse Sensitivity:" HorizontalAlignment="Center" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2">
            <TextBlock Text="X:" VerticalAlignment="Center" />
            <Slider x:Name="SensXSlider" Width="90" Margin="5,0" Minimum="0.001" Maximum="0.05" TickFrequency="0.001" Style="{StaticResource FlatSlider}" />
            <TextBlock Text="Z:" VerticalAlignment="Center" />
            <Slider x:Name="SensZSlider" Width="90" Margin="5,0" Minimum="0.001" Maximum="0.05" TickFrequency="0.001" Style="{StaticResource FlatSlider}" />
        </StackPanel>

        <TextBlock Text="TrackIR Response:" HorizontalAlignment="Center" Margin="0,10,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1">
            <TextBlock x:Name="DeadzoneLabel" Width="100" VerticalAlignment="Center" />
            <Slider x:Name="DeadzoneSlider" Width="120" Margin="5,0" Minimum="0" Maximum="5" TickFrequency="0.5" Style="{StaticResource FlatSlider}" ValueChanged="Curve_ValueChanged" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1">
            <TextBlock x:Name="CurveLabel" Width="100" VerticalAlignment="Center" />
            <Slider x:Name="CurveSlider" Width="120" Margin="5,0" Minimum="1" Maximum="3" TickFrequency="0.1" Style="{StaticResource FlatSlider}" ValueChanged="Curve_ValueChanged" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,1">
            <TextBlock x:Name="GainLabel" Width="100" VerticalAlignment="Center" />
            <Slider x:Name="GainSlider" Width="120" Margin="5,0" Minimum="1" Maximum="4" TickFrequency="0.1" Style="{StaticResource FlatSlider}" ValueChanged="Curve_ValueChanged" />
        </StackPanel>

        <CheckBox x:Name="TopmostBox" Content="Always on Top" HorizontalAlignment="Center" Margin="0,10,0,0" Style="{StaticResource FlatCheckBox}" />

        <Button Content="APPLY" Width="110" Padding="0,4" Margin="0,15,0,5" Style="{StaticResource FlatButton}" Click="Apply_Click" />
        <Button Content="CANCEL" Width="110" Padding="0,4" Style="{StaticResource QuitButton}" Click="Cancel_Click" />
    </StackPanel>
</Window>
