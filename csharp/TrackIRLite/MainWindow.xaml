<Window x:Class="TrackIRLite.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrackIRLite"
        Title="TrackIR Lite"
        Icon="pack://application:,,,/app.ico"
        Width="1100" Height="700"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BarBrush}"
        BorderBrush="{StaticResource BarBrush}" BorderThickness="1"
        Loaded="Window_Loaded" Closed="Window_Closed" KeyDown="Window_KeyDown">

    <Grid>
        <Border x:Name="VideoArea" Background="Black" Margin="5"
                MouseMove="VideoArea_MouseMove" MouseLeave="VideoArea_MouseLeave"
                MouseLeftButtonDown="VideoArea_MouseLeftButtonDown">
            <Grid>
                <Image x:Name="VideoImage" Stretch="Fill" RenderOptions.BitmapScalingMode="Linear" />
                <local:HudOverlay x:Name="Hud" IsHitTestVisible="False" />
            </Grid>
        </Border>

        <Grid x:Name="TopBar" Height="35" VerticalAlignment="Top"
              Background="{StaticResource BarBrush}"
              MouseLeftButtonDown="TopBar_MouseLeftButtonDown">
            <TextBlock Text="TRACKIR LITE" Margin="10,0,0,0" VerticalAlignment="Center"
                       Foreground="{StaticResource AccentBrush}"
                       FontFamily="Segoe UI" FontSize="12" FontWeight="Bold" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnSetHome" Content="Set Home" Width="70" Style="{StaticResource BarButton}" Click="BtnSetHome_Click" />
                <Button x:Name="BtnReset" Content="Reset" Width="55" Style="{StaticResource BarButton}" Click="BtnReset_Click" />
                <Button x:Name="BtnMode" Content="Mode: 360" Width="85" Style="{StaticResource BarButton}" Click="BtnMode_Click" />
                <Button x:Name="BtnPip" Content="PiP: OFF" Width="70" Style="{StaticResource BarButton}" />
                <Button x:Name="BtnConfig" Content="Config" Width="55" Style="{StaticResource BarButton}" />
                <Button x:Name="BtnFull" Content="Full" Width="55" Style="{StaticResource BarButton}" Click="BtnFull_Click" />
                <Button x:Name="BtnQuit" Content="X" Width="38" Style="{StaticResource QuitButton}" Click="BtnQuit_Click" />
            </StackPanel>
        </Grid>

        <Grid x:Name="BottomBar" Height="45" VerticalAlignment="Bottom"
              Background="{StaticResource BarBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="9*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.ColumnSpan="2" Orientation="Horizontal"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                <Button x:Name="BtnLoadStream" Content="Load Stream" Padding="20,5" Margin="5,0" Style="{StaticResource FlatButton}" Click="BtnLoadStream_Click" />
                <Button x:Name="BtnReloadCams" Content="Reload Cams" Padding="20,5" Margin="5,0" Style="{StaticResource FlatButton}" Click="BtnReloadCams_Click" />
            </StackPanel>
            <StackPanel x:Name="PitchControls" Grid.Column="0" Orientation="Horizontal"
                        HorizontalAlignment="Right" VerticalAlignment="Center">
                <Button x:Name="BtnPitchDown" Content="-" Width="36" Padding="0,5" Margin="5,0" FontWeight="Bold" Style="{StaticResource FlatButton}" Click="BtnPitchDown_Click" />
                <Button x:Name="BtnPitchUp" Content="+" Width="36" Padding="0,5" Margin="5,0" FontWeight="Bold" Style="{StaticResource FlatButton}" Click="BtnPitchUp_Click" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
